ARG FFTM_BASE_IMAGE=nvcr.io/nvidia/hpc-benchmarks:24.06
ARG FFTW_VERSION=3.3.10

FROM ${FFTM_BASE_IMAGE} AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG FFTW_VERSION
ARG FFTW_SHA256=56c932549852cddcfafdab3820b0200c7742675be92179e59e6215b340e26467
ARG BUILD_JOBS=8

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        g++ \
        make && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/fftw-build
RUN curl -fsSLO "https://fftw.org/pub/fftw/fftw-${FFTW_VERSION}.tar.gz" && \
    printf '%s  %s\n' "${FFTW_SHA256}" "fftw-${FFTW_VERSION}.tar.gz" | sha256sum -c - && \
    tar -xzf "fftw-${FFTW_VERSION}.tar.gz" && \
    cd "fftw-${FFTW_VERSION}" && \
    CC=/usr/local/mpi/bin/mpicc \
    MPICC=/usr/local/mpi/bin/mpicc \
    CFLAGS="-O3 -fPIC" \
    ./configure \
        --prefix=/opt/fftw \
        --enable-shared \
        --disable-static \
        --enable-mpi \
        --enable-threads \
        --enable-avx \
        --enable-avx2 \
        --enable-fma \
        --disable-fortran && \
    make -j"${BUILD_JOBS}" && \
    make install

WORKDIR /opt/fftw_cpu_src
COPY cpu_fftw_mpi /opt/fftw_cpu_src
RUN make \
        CXX=/usr/local/mpi/bin/mpicxx \
        FFTW_PREFIX=/opt/fftw \
        BUILD_DIR=/opt/fftw_cpu/bin \
        -j"${BUILD_JOBS}" && \
    test -x /opt/fftw_cpu/bin/fftw_mpi_cpu_benchmark.bin && \
    ldd /opt/fftw_cpu/bin/fftw_mpi_cpu_benchmark.bin

FROM ${FFTM_BASE_IMAGE}

ARG FFTW_VERSION

COPY --from=build /opt/fftw /opt/fftw
COPY --from=build /opt/fftw_cpu/bin /opt/fftw_cpu/bin
COPY cpu_fftw_mpi/README.md /opt/fftw_cpu/

ENV PATH="/opt/fftw_cpu/bin:/usr/local/mpi/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/fftw/lib:/usr/local/mpi/lib:${LD_LIBRARY_PATH}"
ENV FFTW_VERSION="${FFTW_VERSION}"

WORKDIR /opt/fftw_cpu

RUN test -x /opt/fftw_cpu/bin/fftw_mpi_cpu_benchmark.bin && \
    /opt/fftw_cpu/bin/fftw_mpi_cpu_benchmark.bin --help >/dev/null

CMD ["/bin/bash"]
